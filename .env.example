# Aiven Cloud MySQL Connection
DB_URL=jdbc:mysql://mysql-1fadd442-bollanagu6868-7ac8.g.aivencloud.com:10867/defaultdb?useSSL=true&requireSSL=true&sslMode=VERIFY_CA&trustCertificateKeyStoreUrl=file:C:/Users/bolla/Downloads/truststore.jks&trustCertificateKeyStorePassword=changeit&serverTimezone=Asia/Kolkata&allowPublicKeyRetrieval=false
